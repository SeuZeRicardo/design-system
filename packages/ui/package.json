{
  "name": "@acme/ui",
  "version": "0.0.0",
  "sideEffects": false,
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./components": {
      "types": "./src/components/index.ts",
      "import": "./dist/components/index.mjs",
      "require": "./dist/components/index.js"
    },
    "./icons": {
      "types": "./src/icons/index.ts",
      "import": "./dist/icons/index.mjs",
      "require": "./dist/icons/index.js"
    },
    "./styles": {
      "import": "@acme/tokens/styles",
      "require": "@acme/tokens/styles"
    },
    "./themes": {
      "types": "./src/themes/index.ts",
      "import": "./dist/themes/index.mjs",
      "require": "./dist/themes/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint . --max-warnings 0",
    "clean": "rm -rf .turbo node_modules dist"
  },
  "devDependencies": {
    "@acme/eslint-config": "file:../eslint-config",
    "@acme/typescript-config": "file:../typescript-config",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^8.57.0",
    "react": "^19.0.0",
    "tsup": "^8.0.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@acme/tokens": "*",
    "react": "^18.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
